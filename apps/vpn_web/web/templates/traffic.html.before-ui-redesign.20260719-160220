<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>流量与安全监控面板</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- ECharts -->
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
        }
        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }
        pre {
            white-space: pre-wrap;
            word-wrap: break-word;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.5); 
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(71, 85, 105, 0.8); 
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen p-4 md:p-8">

    <div class="max-w-6xl mx-auto space-y-6">
        <!-- 头部 -->
        <div class="flex items-center justify-between glass-panel rounded-2xl p-6">
            <div>
                <h1 class="text-2xl font-bold text-white mb-1">流量与安全监控</h1>
                <p class="text-sm text-slate-400">基于 vnStat & 系统安全日志分析</p>
            </div>
            <div class="flex space-x-4">
                <a href="/" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg text-sm transition-colors text-white">返回主页</a>
                <a href="/logout" class="px-4 py-2 bg-red-500 hover:bg-red-600 rounded-lg text-sm transition-colors text-white">安全退出</a>
            </div>
        </div>

        <!-- 加载状态 -->
        <div id="loading" class="text-center py-20 text-slate-400">
            <svg class="animate-spin h-8 w-8 mx-auto mb-4 text-indigo-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            正在拉取节点数据...
        </div>

        <!-- 数据内容区 -->
        <div id="dashboard" class="hidden space-y-6">
            
            <!-- 总览卡片 -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="glass-panel rounded-2xl p-6">
                    <h3 class="text-slate-400 text-sm font-medium mb-1">今日流量 (RX/TX)</h3>
                    <div id="stat-today" class="text-2xl font-bold text-indigo-400">--</div>
                </div>
                <div class="glass-panel rounded-2xl p-6">
                    <h3 class="text-slate-400 text-sm font-medium mb-1">本月流量 (RX/TX)</h3>
                    <div id="stat-month" class="text-2xl font-bold text-emerald-400">--</div>
                </div>
                <div class="glass-panel rounded-2xl p-6">
                    <h3 class="text-slate-400 text-sm font-medium mb-1">系统总计流量</h3>
                    <div id="stat-total" class="text-2xl font-bold text-amber-400">--</div>
                </div>
            </div>

            <!-- 图表区 -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="glass-panel rounded-2xl p-6">
                    <h3 class="text-white font-medium mb-4">最近 24 小时流量</h3>
                    <div id="chart-hourly" style="width: 100%; height: 300px;"></div>
                </div>
                <div class="glass-panel rounded-2xl p-6">
                    <h3 class="text-white font-medium mb-4">最近 30 天流量</h3>
                    <div id="chart-daily" style="width: 100%; height: 300px;"></div>
                </div>
            </div>

            <!-- 诊断日志区 -->
            <div class="glass-panel rounded-2xl p-6">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-white font-bold text-lg flex items-center">
                        <svg class="w-5 h-5 mr-2 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        系统安全与连接检测
                    </h3>
                    <span id="log-time" class="text-xs text-slate-400 bg-slate-800 px-3 py-1 rounded-full border border-slate-700">更新时间: --</span>
                </div>

                <!-- 顶栏状态 -->
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div class="bg-slate-800/50 rounded-xl p-4 border border-slate-700/50 flex items-center justify-between">
                        <span class="text-sm text-slate-400">已建立 TCP 连接</span>
                        <span id="log-tcp" class="text-xl font-bold text-indigo-400">--</span>
                    </div>
                    <div class="bg-slate-800/50 rounded-xl p-4 border border-slate-700/50 flex items-center justify-between">
                        <span class="text-sm text-slate-400">等待建立的连接 (SYN)</span>
                        <span id="log-syn" class="text-xl font-bold text-rose-400">--</span>
                    </div>
                </div>

                <!-- 详情网格 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">连接最多的目标 IP</h4>
                        <div class="bg-slate-900/80 border border-slate-800 rounded-lg p-3 h-48 overflow-y-auto custom-scrollbar">
                            <pre id="log-ips" class="text-xs font-mono text-emerald-300 m-0"></pre>
                        </div>
                    </div>
                    <div>
                        <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">尚未建立成功的连接</h4>
                        <div class="bg-slate-900/80 border border-slate-800 rounded-lg p-3 h-48 overflow-y-auto custom-scrollbar">
                            <pre id="log-syn-list" class="text-xs font-mono text-amber-300 m-0"></pre>
                        </div>
                    </div>
                    <div>
                        <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">高占用进程</h4>
                        <div class="bg-slate-900/80 border border-slate-800 rounded-lg p-3 h-48 overflow-y-auto custom-scrollbar">
                            <pre id="log-cpu" class="text-xs font-mono text-indigo-300 m-0"></pre>
                        </div>
                    </div>
                    <div>
                        <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">安全拦截记录</h4>
                        <div class="bg-slate-900/80 border border-slate-800 rounded-lg p-3 h-48 overflow-y-auto custom-scrollbar">
                            <pre id="log-sec" class="text-xs font-mono text-rose-300 m-0"></pre>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>

    <script>
        function formatBytes(bytes) {
            if (bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        async function loadData() {
            try {
                const res = await fetch('/api/traffic');
                if (res.status === 401) {
                    window.location.href = '/';
                    return;
                }
                const data = await res.json();
                
                document.getElementById('loading').style.display = 'none';
                document.getElementById('dashboard').style.display = 'block';

                // 渲染日志
                if (data.log && typeof data.log === 'object' && !data.log.error) {
                    const l = data.log;
                    document.getElementById('log-time').innerText = `更新时间: ${l.time || '--'}`;
                    document.getElementById('log-tcp').innerText = l.tcp_est || '--';
                    document.getElementById('log-syn').innerText = l.tcp_syn || '--';
                    
                    document.getElementById('log-ips').innerText = l.top_ips || '无记录';
                    document.getElementById('log-syn-list').innerText = l.syn_sent || '无记录';
                    
                    document.getElementById('log-cpu').innerText = 
                        `[Top CPU]\n${l.top_cpu || '无记录'}\n\n[Top Memory]\n${l.top_mem || '无记录'}`;
                    
                    document.getElementById('log-sec').innerText = 
                        `[SSH Failures]\n${l.ssh_fail || '无记录'}\n\n[UFW Blocks]\n${l.ufw_block || '无记录'}`;
                } else {
                    document.getElementById('log-time').innerText = `错误: ${data.log ? data.log.error : '无法解析日志'}`;
                }

                if (data.vnstat && data.vnstat.interfaces && data.vnstat.interfaces.length > 0) {
                    // 取第一个网卡的数据
                    const iface = data.vnstat.interfaces[0];
                    const traffic = iface.traffic;

                    // 汇总统计渲染
                    if (traffic.day && traffic.day.length > 0) {
                        const today = traffic.day[0];
                        document.getElementById('stat-today').innerText = `${formatBytes(today.rx)} / ${formatBytes(today.tx)}`;
                    }
                    if (traffic.month && traffic.month.length > 0) {
                        const month = traffic.month[0];
                        document.getElementById('stat-month').innerText = `${formatBytes(month.rx)} / ${formatBytes(month.tx)}`;
                    }
                    if (traffic.total) {
                        document.getElementById('stat-total').innerText = `${formatBytes(traffic.total.rx)} / ${formatBytes(traffic.total.tx)}`;
                    }

                    // 渲染每小时图表
                    if (traffic.hour && traffic.hour.length > 0) {
                        const hours = [...traffic.hour].reverse(); // vnstat通常是新的在前面，我们反转为时间顺序
                        const hourChart = echarts.init(document.getElementById('chart-hourly'));
                        hourChart.setOption({
                            tooltip: { trigger: 'axis' },
                            legend: { data: ['下载(RX)', '上传(TX)'], textStyle: { color: '#94a3b8' } },
                            grid: { left: '3%', right: '4%', bottom: '3%', containLabel: true },
                            xAxis: { 
                                type: 'category', 
                                data: hours.map(h => `${h.date.hour}:00`),
                                axisLabel: { color: '#94a3b8' }
                            },
                            yAxis: { 
                                type: 'value',
                                axisLabel: { 
                                    color: '#94a3b8',
                                    formatter: value => formatBytes(value)
                                },
                                splitLine: { lineStyle: { color: '#334155' } }
                            },
                            series: [
                                { name: '下载(RX)', type: 'line', smooth: true, itemStyle: { color: '#10b981' }, areaStyle: { color: 'rgba(16, 185, 129, 0.2)' }, data: hours.map(h => h.rx) },
                                { name: '上传(TX)', type: 'line', smooth: true, itemStyle: { color: '#6366f1' }, areaStyle: { color: 'rgba(99, 102, 241, 0.2)' }, data: hours.map(h => h.tx) }
                            ]
                        });
                    }

                    // 渲染每日图表
                    if (traffic.day && traffic.day.length > 0) {
                        const days = [...traffic.day].reverse();
                        const dayChart = echarts.init(document.getElementById('chart-daily'));
                        dayChart.setOption({
                            tooltip: { trigger: 'axis' },
                            legend: { data: ['下载(RX)', '上传(TX)'], textStyle: { color: '#94a3b8' } },
                            grid: { left: '3%', right: '4%', bottom: '3%', containLabel: true },
                            xAxis: { 
                                type: 'category', 
                                data: days.map(d => `${d.date.month}-${d.date.day}`),
                                axisLabel: { color: '#94a3b8' }
                            },
                            yAxis: { 
                                type: 'value',
                                axisLabel: { 
                                    color: '#94a3b8',
                                    formatter: value => formatBytes(value)
                                },
                                splitLine: { lineStyle: { color: '#334155' } }
                            },
                            series: [
                                { name: '下载(RX)', type: 'bar', stack: 'total', itemStyle: { color: '#10b981' }, data: days.map(d => d.rx) },
                                { name: '上传(TX)', type: 'bar', stack: 'total', itemStyle: { color: '#6366f1' }, data: days.map(d => d.tx) }
                            ]
                        });
                    }
                } else {
                    document.getElementById('stat-today').innerText = '暂无数据 (请等待 vnStat 采集)';
                }

            } catch (e) {
                console.error(e);
                document.getElementById('loading').innerHTML = `<span class="text-red-500">加载失败: ${e.message}</span>`;
            }
        }

        // 自适应图表缩放
        window.addEventListener('resize', () => {
            const chart1 = echarts.getInstanceByDom(document.getElementById('chart-hourly'));
            const chart2 = echarts.getInstanceByDom(document.getElementById('chart-daily'));
            if(chart1) chart1.resize();
            if(chart2) chart2.resize();
        });

        loadData();
    </script>
</body>
</html>
