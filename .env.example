# =============================================================================
# Xray_portal 环境变量配置模板 (.env.example)
# 使用说明: 请拷贝本文件为 .env，并根据实际情况修改配置参数。切勿将 .env 提交至 Git。
# =============================================================================

# =========================
# 1. 订阅合成系统核心配置
# =========================

# 美国主控机公网 IP (用于荷兰向美国同步)
US_SERVER_IP=replace_me

# 荷兰副机公网 IP (用于美国向荷兰推送)
NL_SERVER_IP=replace_me

# 美国主订阅服务的公网域名
US_SUB_DOMAIN=replace_me

# 荷兰备用订阅服务的公网域名
NL_SUB_DOMAIN=replace_me

# 高强度随机 Token (至少 32 字节，客户端安全凭据，严防外泄)
# 示例生成: python3 -c "import secrets; print(secrets.token_hex(32))"
SUB_TOKEN=replace_me

# =========================
# 2. Flask 前端管理面板配置
# =========================

# 面板管理员登录密码
PORTAL_PASSWORD=replace_me

# Flask 内部加密 Secret Key (如不提供将默认等于 PORTAL_PASSWORD)
FLASK_SECRET_KEY=replace_me

# =========================
# 3. Telegram 消息机器人 (可选)
# =========================

# 桥接分享机器人 Bot Token (对应 bridge_bot)
BRIDGE_BOT_TOKEN=replace_me

# 转发拦截机器人 Bot Token (对应 tg_bot)
CHANNEL_BOT_TOKEN=replace_me

# 消息拦截转发的目标频道 ID (如 -100xxxxxxxxxx)
CHANNEL_GROUP_ID=replace_me

# 机器人服务管理员的 Telegram 用户 ID (用于授权操作)
CHANNEL_ADMIN_ID=replace_me

# =========================
# 4. QQ 桥接 Bot 配置 (可选)
# =========================

# 互通桥接的目标 QQ 群号
BRIDGE_TARGET_QQ_GROUP=replace_me
BRIDGE_TARGET_QQ_TYPE=group

# NapCat (OneBot11) 的 API 发送消息接口地址
BRIDGE_NAPCAT_API_URL=http://127.0.0.1:3000/send_msg
BRIDGE_NAPCAT_TIMEOUT=300
BRIDGE_NAPCAT_MAX_CONCURRENCY=1
BRIDGE_MEDIA_GROUP_SETTLE_DELAY=8
BRIDGE_FORWARD_MODE=both

# =========================
# 5. Clash 本地输入源物理路径 (可选)
# =========================
CLASH_US_SOURCE=/var/www/clash/clash.yaml
CLASH_NL_SOURCE=/var/www/clash/clash.yaml
US_PUBLISH_DIR=/opt/clash-sub/published
NL_MIRROR_DIR=/var/www/sub
