server {
    server_name test.finalfinal.dpdns.org;
    listen 80;
    listen [::]:80;

    # =========================================================================
    # 1. 【隐藏分发】合并后的 Clash 唯一最终对外订阅 (强随机 Token 保护)
    # =========================================================================
    location = /21e19027b6671b67301fc520affdb341c748bf9862aafd3aed9a0ad79ad2d8ed/clash.yaml {
        alias /opt/clash-sub/published/clash.yaml;
        add_header X-Robots-Tag "noindex, nofollow";
        add_header Content-Type "text/yaml; charset=utf-8";
        auth_basic off;
        autoindex off;
    }

    # =========================================================================
    # 2. 【精准放行】Clash 客户端旧版更新链接 (完全公开，无需密码)
    # =========================================================================
    location = /clash.yaml {
        proxy_pass http://127.0.0.1:8080; # 默默转发给后端的 clash 服务
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        auth_basic off; # 👈 关键：显式关闭密码认证，方便客户端自动更新
    }

    # =========================================================================
    # 3. 【密码保护】代理配置面板首页及所有资源（完美兼容面板结构，绝不乱码/空白）
    # =========================================================================
    location / {
        proxy_pass http://127.0.0.1:8080; # 依然保持在根目录，JS/CSS 路径绝不会错乱
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # =========================================================================
    # 4. 【其他业务】YouTube 字幕后端（各自独立，完全不受密码影响）
    # =========================================================================
    location /api/ {
        proxy_pass http://127.0.0.1:9000;
    }

    # Certbot 自动托管的 SSL 证书链保持在最下方...
    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/test.finalfinal.dpdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test.finalfinal.dpdns.org/privkey.pem;
}

# =========================================================================
# 5. 【独立物理隔离】专用于 TG Bot 媒体分享的 HTTPS 独立端口服务 (不干扰 443 端口主站)
# =========================================================================
server {
    listen 8083 ssl;
    listen [::]:8083 ssl;
    server_name test.finalfinal.dpdns.org;

    ssl_certificate /etc/letsencrypt/live/test.finalfinal.dpdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test.finalfinal.dpdns.org/privkey.pem;

    error_page 497 =301 https://$host:$server_port$request_uri;

    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }

    location /protected_media/ {
        internal;
        alias /var/lib/tg-bridge-cache/;
        mp4;
        mp4_buffer_size       1m;
        mp4_max_buffer_size   5m;
        sendfile           on;
        tcp_nopush         on;
        tcp_nodelay        on;
        keepalive_timeout  65;
    }
}
