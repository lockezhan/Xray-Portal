# =============================================================================
# Xray_portal Secondary 副机专用环境变量配置模板 (deploy/env/secondary.env.example)
# 使用方法:
#   cp deploy/env/secondary.env.example .env
#   chmod 600 .env
#   $EDITOR .env   # 填写所有 replace_me 字段
#
# ⚠️ 安全警告：
#   Secondary 副机严禁在此文件中填入以下内容：
#   - Flask 面板密码（PORTAL_PASSWORD / FLASK_SECRET_KEY）
#   - Bot Token（BRIDGE_BOT_TOKEN / CHANNEL_BOT_TOKEN）
#   - 任何Primary端专有秘密凭据
# =============================================================================

# =========================
# 1. 节点与订阅核心配置
# =========================
# Secondary 副机公网 IP
SECONDARY_SERVER_IP=replace_me

# Primary主服务器公网 IP（向其目标推流验证）
PRIMARY_SERVER_IP=replace_me

# Secondary备用订阅服务的公网访问域名
SECONDARY_SUB_DOMAIN=replace_me

# 高强度随机 Token（须与Primary主服务器的 SUB_TOKEN 完全一致）
SUB_TOKEN=replace_me

# =========================
# 2. Xray 代理服务配置
# =========================
# 是否在部署时自动安装 Xray 代理（默认 true）
INSTALL_PROXY=true

# 代理服务域名（建议使用灰云 CF A 记录或裸 IP）
PROXY_DOMAIN=replace_me

# 代理端口配置（须与客户端 Clash 配置一致）
PROXY_PORT_V4=20001
PROXY_PORT_V6=20002
PROXY_PORT_LEGACY=20003

# 是否启用 IPv6 inbound
PROXY_ENABLE_IPV6=true

# 是否启用 Legacy AES-256-GCM inbound
PROXY_ENABLE_LEGACY=false

# 加密方法
PROXY_METHOD_V4=2022-blake3-aes-128-gcm
PROXY_METHOD_V6=2022-blake3-aes-128-gcm

# 代理密钥（留空则自动安全生成并写入 /etc/xray-portal/proxy.env）
# 注意：Secondary 与 Primary 的密钥是独立的，因为是两台独立的 Xray 服务器
PROXY_KEY_V4=
PROXY_KEY_V6=
PROXY_KEY_LEGACY=

# =========================
# 3. 固定版本与 SHA256 校验（安全要求）
# =========================
XRAY_VERSION=v26.6.27
# 获取 SHA256: curl -sL https://github.com/XTLS/Xray-core/releases/download/v26.6.27/Xray-linux-64.zip.dgst
XRAY_SHA256_LINUX_AMD64=b3e5902d06d6282fe53cfa2fc426058b9aeaa429b2c812e20887cd47f26d08bf
XRAY_SHA256_LINUX_ARM64=13a251379bea366c2cf10363ad71e75734193d401f26f518bf0c25e5c8f8c931

# Mihomo 版本（Secondary端用于本地订阅校验）
MIHOMO_VERSION=v1.18.10
MIHOMO_SHA256_LINUX_AMD64=362467189fc580ab680bad25b9040eb6f5a54ff534e5d37065165912a914f3f3
MIHOMO_SHA256_LINUX_ARM64=6bc6ae164e3f8c126d6b02a173d40a88dac518af6c19a9ac41306220873fae01

# =========================
# 4. 防火墙与网络优化
# =========================
CONFIGURE_UFW=true
ENABLE_BBR=true

# =========================
# 5. Nginx 条件启用
# =========================
# Secondary端仅作为静态只读镜像站，无 Web/API/Bot 服务
ENABLE_WEB=false
ENABLE_API=false
ENABLE_BOTS=false

# =========================
# 6. 本地物理路径与账户配置
# =========================
# Secondary节点自身 YAML 源配置
CLASH_SECONDARY_SOURCE=/var/www/clash/clash.yaml

# 订阅镜像站对外分发根目录
SECONDARY_MIRROR_DIR=/var/www/sub

# Secondary镜像服务运行受限用户与组
SUBMIRROR_USER=submirror
SUBMIRROR_GROUP=submirror
