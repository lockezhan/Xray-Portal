# =============================================================================
# Xray_portal 荷兰副机专用环境变量配置模板 (deploy/env/nl.env.example)
# 使用方法: cp deploy/env/nl.env.example .env 并修改参数
# 注意: 荷兰备机仅负责独立节点推送和订阅只读分发，严禁在此文件中填入任何
#       Flask 面板密码、Bot Token 或美国端专有秘密凭据！
# =============================================================================

# =========================
# 1. 节点与订阅核心配置
# =========================
# 荷兰副机公网 IP
NL_SERVER_IP=replace_me

# 美国主服务器公网 IP (用于向其目标推流验证)
US_SERVER_IP=replace_me

# 荷兰备用订阅服务的公网访问域名
NL_SUB_DOMAIN=replace_me

# 高强度随机 Token (须与美国主服务器的 SUB_TOKEN 保持完全一致)
SUB_TOKEN=replace_me

# =========================
# 2. 本地物理路径与账户运行配置
# =========================
# 荷兰节点自身 YAML 源配置
CLASH_NL_SOURCE=/var/www/clash/clash.yaml

# 订阅镜像站对外分发根目录
NL_MIRROR_DIR=/var/www/sub

# 荷兰镜像服务运行受限用户与组
SUBMIRROR_USER=submirror
SUBMIRROR_GROUP=submirror
