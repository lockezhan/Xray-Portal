# =============================================================================
# Xray_portal 荷兰副机专用环境变量配置模板 (deploy/env/nl.env.example)
# 使用方法:
#   cp deploy/env/nl.env.example .env
#   chmod 600 .env
#   $EDITOR .env   # 填写所有 replace_me 字段
#
# ⚠️ 安全警告：
#   荷兰副机严禁在此文件中填入以下内容：
#   - Flask 面板密码（PORTAL_PASSWORD / FLASK_SECRET_KEY）
#   - Bot Token（BRIDGE_BOT_TOKEN / CHANNEL_BOT_TOKEN）
#   - 任何美国端专有秘密凭据
# =============================================================================

# =========================
# 1. 节点与订阅核心配置
# =========================
# 荷兰副机公网 IP
NL_SERVER_IP=replace_me

# 美国主服务器公网 IP（向其目标推流验证）
US_SERVER_IP=replace_me

# 荷兰备用订阅服务的公网访问域名
NL_SUB_DOMAIN=replace_me

# 高强度随机 Token（须与美国主服务器的 SUB_TOKEN 完全一致）
SUB_TOKEN=replace_me

# =========================
# 2. Xray 代理服务配置
# =========================
# 是否在部署时自动安装 Xray 代理（默认 true）
INSTALL_PROXY=true

# 代理服务域名（建议使用灰云 CF A 记录或裸 IP）
PROXY_DOMAIN=replace_me

# 代理端口配置（须与客户端 Clash 配置一致）
PROXY_PORT_V4=20001
PROXY_PORT_V6=20002
PROXY_PORT_LEGACY=20003

# 是否启用 IPv6 inbound
PROXY_ENABLE_IPV6=true

# 是否启用 Legacy AES-256-GCM inbound
PROXY_ENABLE_LEGACY=false

# 加密方法
PROXY_METHOD_V4=2022-blake3-aes-128-gcm
PROXY_METHOD_V6=2022-blake3-aes-128-gcm

# 代理密钥（留空则自动安全生成并写入 /etc/xray-portal/proxy.env）
# 注意：NL 与 US 的密钥是独立的，因为是两台独立的 Xray 服务器
PROXY_KEY_V4=
PROXY_KEY_V6=
PROXY_KEY_LEGACY=

# =========================
# 3. 固定版本与 SHA256 校验（安全要求）
# =========================
XRAY_VERSION=v25.6.3
# 获取 SHA256: curl -sL https://github.com/XTLS/Xray-core/releases/download/v25.6.3/Xray-linux-64.zip.sha256sum
XRAY_SHA256_LINUX_AMD64=replace_me
XRAY_SHA256_LINUX_ARM64=replace_me

# Mihomo 版本（荷兰端用于本地订阅校验）
MIHOMO_VERSION=v1.18.10
MIHOMO_SHA256_LINUX_AMD64=replace_me
MIHOMO_SHA256_LINUX_ARM64=replace_me

# =========================
# 4. 防火墙与网络优化
# =========================
CONFIGURE_UFW=true
ENABLE_BBR=true

# =========================
# 5. Nginx 条件启用
# =========================
# 荷兰端仅作为静态只读镜像站，无 Web/API/Bot 服务
ENABLE_WEB=false
ENABLE_API=false
ENABLE_BOTS=false

# =========================
# 6. 本地物理路径与账户配置
# =========================
# 荷兰节点自身 YAML 源配置
CLASH_NL_SOURCE=/var/www/clash/clash.yaml

# 订阅镜像站对外分发根目录
NL_MIRROR_DIR=/var/www/sub

# 荷兰镜像服务运行受限用户与组
SUBMIRROR_USER=submirror
SUBMIRROR_GROUP=submirror
