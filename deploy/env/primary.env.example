# =============================================================================
# Xray_portal Primary主控机环境变量配置模板 (deploy/env/primary.env.example)
# 使用方法:
#   cp deploy/env/primary.env.example .env
#   chmod 600 .env
#   $EDITOR .env   # 填写所有 replace_me 字段
# =============================================================================

# =========================
# 1. 节点与订阅核心配置
# =========================
# Primary主服务器公网 IP
PRIMARY_SERVER_IP=replace_me

# Secondary 副机公网 IP（允许其进行 rsync/ssh 镜像同步）
SECONDARY_SERVER_IP=replace_me

# Primary主订阅服务的公网访问域名
PRIMARY_SUB_DOMAIN=replace_me

# Secondary备用订阅服务的公网访问域名
SECONDARY_SUB_DOMAIN=replace_me

# 高强度随机 Token（建议 32 字节十六进制）
# 生成命令: python3 -c "import secrets; print(secrets.token_hex(32))"
SUB_TOKEN=replace_me

# =========================
# 2. Flask 管理面板配置
# =========================
# 面板管理员登录口令
PORTAL_PASSWORD=replace_me

# Flask 会话加密 Secret Key（建议 64 字节十六进制）
# 生成命令: python3 -c "import secrets; print(secrets.token_hex(64))"
FLASK_SECRET_KEY=replace_me

# =========================
# 3. Xray 代理服务配置
# =========================
# 是否在部署时自动安装 Xray 代理（默认 true）
INSTALL_PROXY=true

# 代理服务域名（建议使用灰云 CF A 记录或裸 IP）
PROXY_DOMAIN=replace_me

# 代理端口配置
PROXY_PORT_V4=20001
PROXY_PORT_V6=20002
PROXY_PORT_LEGACY=20003

# 是否启用 IPv6 inbound
PROXY_ENABLE_IPV6=true

# 是否启用 Legacy AES-256-GCM inbound（兼容旧客户端，默认关闭）
PROXY_ENABLE_LEGACY=false

# 加密方法
PROXY_METHOD_V4=2022-blake3-aes-128-gcm
PROXY_METHOD_V6=2022-blake3-aes-128-gcm

# 代理密钥（留空则自动安全生成并写入 /etc/xray-portal/proxy.env）
# 警告：自动生成的密钥不会打印到终端，请从 /etc/xray-portal/proxy.env 查看
# 生成命令（手动）: openssl rand -base64 16
PROXY_KEY_V4=
PROXY_KEY_V6=
PROXY_KEY_LEGACY=

# =========================
# 4. 固定版本与 SHA256 校验（安全要求：必须指定）
# =========================
# Xray-core 版本（修改版本时必须同步更新 SHA256）
XRAY_VERSION=v26.6.27
# 获取 SHA256: curl -sL https://github.com/XTLS/Xray-core/releases/download/v26.6.27/Xray-linux-64.zip.dgst
XRAY_SHA256_LINUX_AMD64=b3e5902d06d6282fe53cfa2fc426058b9aeaa429b2c812e20887cd47f26d08bf
XRAY_SHA256_LINUX_ARM64=13a251379bea366c2cf10363ad71e75734193d401f26f518bf0c25e5c8f8c931

# Mihomo（Clash Meta）版本
MIHOMO_VERSION=v1.18.10
# 获取 SHA256: 通过 https://github.com/MetaCubeX/mihomo/releases/tag/v1.18.10 计算
MIHOMO_SHA256_LINUX_AMD64=362467189fc580ab680bad25b9040eb6f5a54ff534e5d37065165912a914f3f3
MIHOMO_SHA256_LINUX_ARM64=6bc6ae164e3f8c126d6b02a173d40a88dac518af6c19a9ac41306220873fae01

# =========================
# 5. 防火墙与网络优化
# =========================
# 是否配置 UFW 防火墙（默认 true）
CONFIGURE_UFW=true

# 是否启用 TCP BBR 拥塞控制（默认 true）
ENABLE_BBR=true

# =========================
# 6. Nginx 条件启用（安全要求：未实现的服务必须为 false）
# =========================
# 启用 Flask Web 面板（/ 代理到 8080）
ENABLE_WEB=true

# 启用 API 后端（/api/ 代理到 9000）
# 注意：API 服务未部署时必须保持 false，否则 Nginx 会代理死端口产生 502
ENABLE_API=false

# 启用 Bot 媒体服务（8083 端口代理到 8082）
# 注意：Bot 服务未部署时必须保持 false
ENABLE_BOTS=false

# =========================
# 7. Telegram / QQ 机器人（可选，未部署时保持 replace_me）
# =========================
BRIDGE_BOT_TOKEN=replace_me
CHANNEL_BOT_TOKEN=replace_me
CHANNEL_GROUP_ID=replace_me
CHANNEL_ADMIN_ID=replace_me
BRIDGE_TARGET_QQ_GROUP=replace_me
BRIDGE_TARGET_QQ_TYPE=group
BRIDGE_NAPCAT_API_URL=http://127.0.0.1:3000/send_msg
BRIDGE_NAPCAT_TIMEOUT=300
BRIDGE_NAPCAT_MAX_CONCURRENCY=1
BRIDGE_NAPCAT_WS_URL=ws://127.0.0.1:3001
BRIDGE_NAPCAT_STREAM_THRESHOLD=52428800
BRIDGE_NAPCAT_STREAM_CHUNK_SIZE=1048576
BRIDGE_MEDIA_GROUP_SETTLE_DELAY=8
BRIDGE_WEB_TRANSCODE_MAX_CONCURRENCY=1
BRIDGE_WEB_TRANSCODE_PRESET=veryfast
BRIDGE_WEB_TRANSCODE_CRF=23
BRIDGE_FORWARD_MODE=both

# =========================
# 8. 本地物理路径与账户配置
# =========================
# Xray 节点源 YAML 文件路径
CLASH_PRIMARY_SOURCE=/var/www/clash/clash.yaml

# 合成后订阅文件发布目录
PRIMARY_PUBLISH_DIR=/opt/clash-sub/published

# Primary端专用受限服务账户与组
SUBPUSH_USER=subpush
SUBPUSH_GROUP=subpush
PRIMARY_INSTALL_DIR=/opt/clash-sub
