# =============================================================================
# Xray_portal 美国主控机环境变量配置模板 (deploy/env/us.env.example)
# 使用方法: cp deploy/env/us.env.example .env 并修改参数
# =============================================================================

# =========================
# 1. 节点与订阅核心配置
# =========================
# 美国主服务器公网 IP
US_SERVER_IP=replace_me

# 荷兰副机公网 IP (用于允许其进行 rsync/ssh 镜像同步或故障转移配置)
NL_SERVER_IP=replace_me

# 美国主订阅服务的公网访问域名
US_SUB_DOMAIN=replace_me

# 荷兰备用订阅服务的公网访问域名 (非对称故障转移或前端展示)
NL_SUB_DOMAIN=replace_me

# 高强度随机 Token (建议 32 字节十六进制，如 python3 -c "import secrets; print(secrets.token_hex(32))")
SUB_TOKEN=replace_me

# =========================
# 2. Flask 管理面板配置
# =========================
# 面板管理员登录口令
PORTAL_PASSWORD=replace_me

# Flask 会话加密 Secret Key
FLASK_SECRET_KEY=replace_me

# =========================
# 3. Telegram / QQ 机器人相关配置 (可选)
# =========================
BRIDGE_BOT_TOKEN=replace_me
CHANNEL_BOT_TOKEN=replace_me
CHANNEL_GROUP_ID=replace_me
CHANNEL_ADMIN_ID=replace_me
BRIDGE_TARGET_QQ_GROUP=replace_me
BRIDGE_NAPCAT_API_URL=http://127.0.0.1:3000/send_msg

# =========================
# 4. 本地物理路径与账户运行配置
# =========================
# Xray 节点源 YAML 文件路径
CLASH_US_SOURCE=/var/www/clash/clash.yaml

# 合成后订阅文件发布目录
US_PUBLISH_DIR=/opt/clash-sub/published

# 美国端专用受限服务账户与组
SUBPUSH_USER=subpush
SUBPUSH_GROUP=subpush
US_INSTALL_DIR=/opt/clash-sub
